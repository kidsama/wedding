/* ========== 相册页（奶油底 + 白色卡片，与参考图一致） ========== */
.al-page {
  min-height: 100vh;
  background: #fdf6e9;
  padding: 24rpx 36rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ========== 相册卡片：左方形封面 + 右信息 ========== */
.al-cards {
  margin-top: 8rpx;
}

.al-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(120, 90, 60, 0.08);
}

.al-card + .al-card {
  margin-top: 22rpx;
}

.al-card-hover {
  background: #fdf9f0;
}

.al-cover-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;   /* 正方形封面 */
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f3efe6;
}

.al-cover {
  width: 100%;
  height: 100%;
}

/* 张数角标：封面右下角（小而轻） */
.al-count {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 18rpx;
  background: rgba(20, 12, 8, 0.55);
  color: rgba(255, 255, 255, 0.96);
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.al-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-self: stretch;
  padding: 12rpx 8rpx 8rpx 26rpx;
}

.al-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3d2e26;
  letter-spacing: 1rpx;
}

.al-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9d968a;
  letter-spacing: 1rpx;
}

.al-view {
  margin-top: auto;
  align-self: flex-end;
  font-size: 24rpx;
  color: #e2402c;
  letter-spacing: 2rpx;
}

/* 底部提示 */
.al-end {
  margin-top: 56rpx;
  text-align: center;
  font-size: 20rpx;
  color: #d5cab6;
  letter-spacing: 4rpx;
}

/* ========== 相册内：返回 + 照片网格 ========== */
.al-back {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx 8rpx 0;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #b08a6a;
}

.al-back-hover {
  opacity: 0.7;
}

.al-album-name {
  margin-top: 4rpx;
  text-align: center;
  font-size: 34rpx;
  letter-spacing: 8rpx;
  color: #e2402c;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-weight: bold;
}

/* 三列网格，白边错落感 */
.al-grid {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
}

.al-item {
  width: calc((100% - 24rpx) / 3);
  height: 212rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: 10rpx;
  overflow: hidden;
  border: 6rpx solid #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(90, 60, 40, 0.12);
  box-sizing: border-box;
}

.al-item:nth-child(3n) {
  margin-right: 0;
}

.al-hover {
  opacity: 0.82;
}

.al-img {
  width: 100%;
  height: 100%;
}

.al-tip {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #c8b89a;
  letter-spacing: 2rpx;
}
