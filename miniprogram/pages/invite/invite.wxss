/* ========== 列表模式：邀请函选择 ========== */
.ivl {
  height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 50rpx 36rpx 60rpx;
  box-sizing: border-box;
}

.ivl-head {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ivl-line {
  width: 90rpx;
  height: 1rpx;
  background: #d3a97c;
  opacity: 0.6;
}

.ivl-title {
  margin: 0 26rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #241d18;
  letter-spacing: 6rpx;
}

.ivl-sub {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b9a893;
  letter-spacing: 3rpx;
}

/* 邀请函卡片：与相册列表同款白卡结构 */
.ivl-card {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(120, 90, 60, 0.08);
}

.ivl-card-hover {
  background: #fdf9f0;
}

.ivl-cover-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f3efe6;
}

.ivl-cover {
  width: 100%;
  height: 100%;
}

.ivl-info {
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.ivl-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #241d18;
}

.ivl-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9d968a;
}

.ivl-open {
  margin-top: 20rpx;
  display: inline-block;
  font-size: 26rpx;
  font-weight: 600;
  color: #e2402c;
  letter-spacing: 2rpx;
}

.ivl-arrow {
  font-size: 28rpx;
  margin-left: 2rpx;
}

.ivl-foot {
  margin-top: 50rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b9a893;
  letter-spacing: 4rpx;
}

/* ========== 详情模式：返回列表按钮 ========== */
.back-btn {
  position: fixed;
  top: 24rpx;
  left: 24rpx;
  z-index: 60;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.12);
  font-size: 24rpx;
  color: #6b5d4d;
  letter-spacing: 2rpx;
}

/* ========== 经典版长页模式 ========== */
.page-long {
  height: auto;
  min-height: 100vh;
}

.long-body {
  background: #fdf6e9;
}

/* 滚动渐显：进入视口后由 IntersectionObserver 加 .on */
.reveal {
  opacity: 0;
  transform: translateY(36rpx);
  transition: opacity 0.9s ease, transform 0.9s ease;
}

.reveal.on {
  opacity: 1;
  transform: translateY(0);
}

/* 长页通用分节 */
.sec {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 44rpx;
  box-sizing: border-box;
  background: #fdf6e9;
}

/* ⓪ 封面区：原第一页视觉在长页顶部的延续 */
.lg-cover {
  width: 100%;
  padding: 90rpx 44rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* ① 头部：头像 + 囍 + 姓名 */
.lg-head {
  width: 100%;
  padding: 96rpx 44rpx 64rpx;
  box-sizing: border-box;
}

.lg-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
}

.lg-avatar {
  width: 172rpx;
  height: 172rpx;
  border-radius: 50%;
}

/* 新郎头像顺时针转 20°（图片为圆形内容+透明四角，绕中心旋转不缺角不空洞） */
.lg-avatar-groom {
  transform: rotate(20deg);
}

.lg-xi {
  margin: 0 34rpx;
  width: 96rpx;
  height: 117rpx;
}

/* 名字行三列与头像行同构（172/96/172 + 34rpx 间距），名字逐一对齐头像中心 */
.lg-names {
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lg-name {
  width: 172rpx;
  text-align: center;
  font-size: 44rpx;
  letter-spacing: 8rpx;
  color: #3d3833;
  font-family: Georgia, "Songti SC", "SimSun", serif;
}

.lg-amp {
  width: 96rpx;
  margin: 0 34rpx;
  text-align: center;
  font-size: 44rpx;
  color: #8a8172;
}

.lg-scripts {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lg-script {
  width: 172rpx;
  text-align: center;
  font-size: 36rpx;
  color: #c96f52;
  font-family: "Snell Roundhand", "Segoe Script", "Brush Script MT", cursive;
}

.lg-script-gap {
  width: 164rpx; /* 囍字 96 + 两侧间距 34×2，与头像行中列等宽 */
}

/* ② 主图 */
.lg-hero {
  position: relative;
  width: 100%;
  padding: 8rpx 36rpx 0;
  box-sizing: border-box;
}

.lg-hero-img {
  width: 100%;
  display: block;
}

.lg-hero-fade {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 0;
  height: 140rpx;
  background: linear-gradient(to bottom, rgba(253, 246, 233, 0), #fdf6e9);
}

.lg-hero-empty {
  width: 100%;
  height: 620rpx;
  border: 2rpx dashed #d8c9ae;
  border-radius: 18rpx;
  background: #fbf4e6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.lg-hero-plus {
  font-size: 64rpx;
  color: #c9b48e;
}

.lg-hero-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #b9a893;
  letter-spacing: 2rpx;
}

/* ③ 故事标题 */
.lg-storytitle {
  width: 100%;
  padding: 66rpx 44rpx 10rpx;
  box-sizing: border-box;
}

.lg-st-main {
  text-align: center;
  font-size: 42rpx;
  letter-spacing: 6rpx;
  color: #3d3833;
  font-family: Georgia, "Songti SC", "SimSun", serif;
}

.lg-st-script {
  margin-top: -10rpx;
  text-align: right;
  padding-right: 56rpx;
  font-size: 42rpx;
  color: #cf6b52;
