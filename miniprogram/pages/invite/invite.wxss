  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}

/* ⑩ 尾页收尾 */
.sec-end {
  padding-bottom: 140rpx;
}

.lg-end {
  height: 2rpx;
}

/* ========== 经典版长页 S1-S10 模板分节 ========== */
/* 通用占位框（槽位未配置照片时显示，宽高由组合类/容器决定） */
.ph-box {
  border: 2rpx dashed #d8c9ae;
  border-radius: 14rpx;
  background: #fbf4e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #b9a893;
  box-sizing: border-box;
}

.ph-fill {
  width: 100%;
  height: 100%;
}

/* S1 门当户对 */
.s1-row {
  display: flex;
  width: 100%;
  gap: 28rpx;
}

.s1-photo {
  width: 296rpx;
  height: 400rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 28rpx rgba(90, 60, 40, 0.14);
}

.s1-img {
  width: 100%;
  height: 100%;
}

.s1-text {
  flex: 1;
  min-width: 0;
  padding-top: 8rpx;
  text-align: right;
}

.s1-line {
  font-size: 25rpx;
  line-height: 1.75;
  letter-spacing: 2rpx;
  color: #3d3833;
}

.s1-slogan {
  align-self: flex-start; /* 分节是 flex column + 居中，靠左需单独声明 */
  margin: 52rpx 0 34rpx;
  font-size: 25rpx;
  letter-spacing: 2rpx;
  color: #3d3833;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.s1-pair {
  display: flex;
  width: 100%;
  gap: 24rpx;
  align-items: flex-start;
  justify-content: space-between; /* 左图贴左、右图贴右，中间自动留距 */
}

.s1-pa {
  width: 300rpx; /* 稍调窄（原半宽 319） */
  height: 380rpx;
  border-radius: 14rpx;
}

.s1-pb {
  width: 253rpx; /* 按原图 2:3 比例（380 × 2/3），aspectFill 不再裁切放大 */
  height: 380rpx;
  border-radius: 14rpx;
}

/* S2 结婚啦 · 日历卡 */
.s2 {
  padding-top: 0; /* 覆盖 .sec 的 80rpx，英文引言整段上移（累计 80） */
  padding-bottom: 270rpx; /* 日历 translateY(40%) 悬空约 189rpx + 余量 */
}

.s2-quote {
  font-size: 26rpx;
  line-height: 1.9;
  letter-spacing: 1rpx;
  color: #e2402c;
  font-style: italic;
  font-family: Georgia, "Times New Roman", serif;
  text-align: right;
}

.s2-quote2 {
  margin-bottom: 34rpx;
}

.s2-wrap {
  position: relative;
  width: 100%;
}

.s2-img {
  width: 100%; /* 实测 4672x7008 = 2:3，撑满内容区 662rpx、左右顶齐内容边缘 */
  height: 993rpx; /* = 662×3/2，原比例零裁切 */
  margin: 0 auto;
  border-radius: 14rpx;
}

.s2-ph {
  height: 560rpx;
}

.cal-card {
  position: absolute;
  left: 90rpx; /* 比撑满的海报窄一圈，露出两侧照片边 */
  right: 90rpx;
  bottom: 0;
  transform: translateY(40%); /* 整体上移：大部分压在照片上，仅下部 40% 悬空 */
  /* 垂直渐变：上半奶油底可读，下半完全透明与背景融为一体（故去边框/阴影） */
  background: linear-gradient(to bottom, rgba(255, 253, 248, 0.88) 0%, rgba(255, 253, 248, 0.82) 42%, rgba(255, 253, 248, 0) 100%);
  border-radius: 18rpx;
  padding: 36rpx 30rpx 34rpx;
  box-sizing: border-box;
}

/* 日历顶部正中囍字图（684x833 竖图，0.821 比例：88→107） */
.cal-xi {
  position: absolute;
  top: -54rpx; /* 高 107 的一半探出日历外，一半压在日历上 */
  left: 50%;
  transform: translateX(-50%);
  width: 88rpx;
  height: 107rpx;
  z-index: 2;
}

.cal-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.cal-date {
  font-size: 56rpx;
  color: #e2402c;
  font-weight: bold;
  font-family: "Heiti SC", "SimHei", "STHeiti", sans-serif; /* 黑体 */
}

.cal-year {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #b08a6a;
  font-family: "Heiti SC", "SimHei", "STHeiti", sans-serif; /* 黑体 */
}

.cal-week {
  display: flex;
  margin-top: 30rpx; /* 行间距加宽，整体垂直拉伸 */
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #e2402c; /* 星期行与日期之间的红色细横线 */
}

.cal-wc {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #b08a6a;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.cal-day {
  width: calc(100% / 7);
  height: 66rpx; /* 行距加宽 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.cal-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #6b5d4d;
}

.cal-num.on {
  position: relative;
  background: transparent;
  color: #e2402c;
  font-weight: bold;
  animation: calHeart 1.6s ease-in-out infinite;
}

/* 空心心形包住当天日期（♡ 绘制在数字后面一层） */
.cal-num.on::before {
  content: '♡';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -54%);
  font-size: 62rpx;
  line-height: 1;
  color: #e2402c;
  z-index: -1;
}

/* S3 慢慢亦漫漫（标题已删，诗直接顶上贴近日历悬空处） */
.s3 {
  padding-top: 0; /* 覆盖 .sec 的 80rpx，文案整体上移 */
}

.s3-poem {
  margin-top: 0;
}

.s3-line {
  font-size: 25rpx;
  line-height: 2.15;
  letter-spacing: 3rpx;
  color: #8a5a4a;
  text-align: center;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.s3-full {
  position: relative;
  width: 100%;
  margin-top: 40rpx;
}

.s3-img {
  width: 100%;
  height: 442rpx; /* DSC09227 = 3:2 横图：精确比例 662/1.5=441.33，取 442 略高于图比例 → aspectFill 改为高度撑满、左右仅裁 0.1%，底边完整不产生采样暗线 */
  border-radius: 14rpx;
}

.s3-ph {
  height: 780rpx;
}

.s3-fade {
  position: absolute;
  left: 0;
  right: 0;
  height: 150rpx;
  pointer-events: none;
}

.s3-fade-top {
  top: 0;
  border-radius: 14rpx 14rpx 0 0;
  background: linear-gradient(to bottom, #fdf6e9, rgba(253, 246, 233, 0));
}

.s3-fade-btm {
  bottom: 0;
  border-radius: 0 0 14rpx 14rpx;
  background: linear-gradient(to top, #fdf6e9, rgba(253, 246, 233, 0));
}

.s3-words {
  position: absolute;
  right: 34rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  gap: 22rpx;
}

.s3-word {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.s3-ch {
  font-size: 30rpx;
  line-height: 1.35;
  color: #fffdf8;
  font-family: Georgia, serif;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.35);
}

.s3-pair {
  display: flex;
  width: 100%;
  gap: 24rpx;
  margin-top: 34rpx;
}

.s3-pi {
  width: calc((100% - 24rpx) / 2);
  height: 479rpx; /* 左右均 2:3 竖图（4672x7008 实测）：宽 319 对应高 319*1.5≈479，原比例零裁切 */
  border-radius: 14rpx;
}

/* S4 关键词 */
.s4-title {
  font-size: 42rpx;
  letter-spacing: 12rpx;
  color: #3d3833;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  text-align: center;
}

.s4-quote {
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #b08a6a;
  text-align: center;
}

.s4-photo {
  position: relative;
  width: 100%;
  margin-top: 36rpx;
}

.s4-img {
  width: 100%;
  height: 820rpx;
  border-radius: 14rpx;
}

.s4-ph {
  height: 820rpx;
}

.s4-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: linear-gradient(to top, rgba(40, 20, 10, 0.45), rgba(40, 20, 10, 0));
  pointer-events: none;
}

.s4-cap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 34rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: #fff8ef;
}

/* S5 WELCOME TO OUR WEDDING */
.s5-row {
  display: flex;
  width: 100%;
  gap: 26rpx;
}

/* 两图并列等大：均实测 3:2 横图（7008x4672），宽 318 对应高 212 零裁切 */
