.s5-names {
  margin-top: 18rpx;
  font-size: 38rpx;
  letter-spacing: 8rpx;
  color: #3d3833;
  font-family: Georgia, "Songti SC", "SimSun", serif;
}

.s5-sub {
  margin-top: 14rpx;
  font-size: 20rpx;
  letter-spacing: 8rpx;
  color: #b9a893;
  font-family: Georgia, serif;
}

/* S6 单图 + 诗（原第二张图与竖排日期已删） */
.s6-img {
  width: 100%;
  height: 993rpx; /* dateA 实测 2:3 竖图：占满 662 宽对应高 993，原比例零裁切（与 S2 海报同款全幅） */
  border-radius: 14rpx;
}

.s6-poem {
  margin-top: 44rpx;
}

.s6-line {
  font-size: 25rpx;
  line-height: 2.3;
  letter-spacing: 3rpx;
  color: #8a5a4a;
  text-align: center;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
