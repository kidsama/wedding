.s8-lunar {
  margin-top: 12rpx;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #b08a6a;
}

.s8-time {
  margin-top: 16rpx;
  font-size: 56rpx; /* 原 104rpx 红色大字太浮夸，改低调：暖黑中号细体 */
  color: #4a3a32;
  font-weight: normal;
  letter-spacing: 6rpx;
  line-height: 1.15;
  font-family: Georgia, serif;
}

/* S9 婚礼地点 */
.s9-mapwrap {
  position: relative;
  width: 100%;
  margin-top: 34rpx;
}

.s9-map {
  width: 100%;
  height: 400rpx;
  border-radius: 14rpx;
}

.s9-nav {
  position: absolute;
  right: 22rpx;
  bottom: 22rpx;
  background: #e2402c;
  color: #fff8ef;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  padding: 14rpx 30rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 18rpx rgba(226, 64, 44, 0.35);
}

.s9-addr {
  margin-top: 30rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  color: #4a3a32;
  font-weight: bold;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.s9-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a08b74;
}

/* S10 出席回执 + 尾页 */
.s10 {
  padding-bottom: 150rpx;
}

.f10-card {
  width: 100%;
  background: #fffdf8;
  border: 1rpx solid #f3e6d0;
  border-radius: 20rpx;
  padding: 44rpx 38rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 30rpx rgba(226, 64, 44, 0.06);
}

.f10-title {
  text-align: center;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  color: #e2402c;
  font-weight: bold;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.f10-row {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.f10-label {
  width: 180rpx;
  font-size: 26rpx;
  color: #6b5d4d;
}

.f10-req {
  color: #e2402c;
  margin-right: 4rpx;
}

.f10-input {
  flex: 1;
  background: #faf3e6;
  border-radius: 14rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: #5a4638;
}

.f10-ph {
  color: #c8b89a;
}

.f10-step {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.f10-sbtn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #eec9b8;
  color: #e2402c;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf8;
}

.f10-num {
  font-size: 38rpx;
  font-weight: bold;
  color: #e2402c;
  min-width: 110rpx;
  text-align: center;
  font-family: Georgia, serif;
}

.f10-submit {
  margin-top: 38rpx;
  height: 92rpx;
  background: linear-gradient(135deg, #ea5a42 0%, #e2402c 100%);
  color: #fff8ef;
  border-radius: 46rpx;
  font-size: 30rpx;
  letter-spacing: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(226, 64, 44, 0.3);
}

.f10-no {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b9a893;
  text-decoration: underline;
  letter-spacing: 2rpx;
}

.f10-done {
  margin-top: 38rpx;
  text-align: center;
  font-size: 28rpx;
  color: #e2402c;
  letter-spacing: 2rpx;
}

.f10-stats {
  margin-top: 24rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a08b74;
}

.f10-num-r {
  color: #e2402c;
  font-weight: bold;
  font-size: 26rpx;
}

.s10-xi {
  margin-top: 90rpx;
  font-size: 96rpx;
  color: #e2402c;
  font-weight: bold;
  font-family: "Songti SC", "SimSun", serif;
}

.s10-close-img {
  display: block;
  margin-top: 30rpx;
  width: 480rpx; /* 文字图 507x69（7.35:1）：480 宽对应高约 65，接近原 52rpx 字级视觉 */
  height: 65rpx;
}

.s10-date {
  margin-top: 24rpx;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #b08a6a;
}

/* 分节内图片统一块级显示，去除基线空隙 */
.s1-img, .s1-pa, .s1-pb, .s2-img, .s3-img, .s3-pi, .s4-img,
.s5-high, .s5-low, .s6-img, .s7-img {
  display: block;
}

/* S2 日历 6 号：心形呼吸缩放（新命名，避免与页脚 heartbeat 冲突） */
@keyframes calHeart {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
