.s7-photo {
  position: relative;
  width: 100%;
}

.s7-img {
  width: 100%;
  height: 442rpx; /* DSC09312 实测 3:2 横图：662 宽对应高 441.33，取 442 高度撑满零裁切且底边不出采样线 */
