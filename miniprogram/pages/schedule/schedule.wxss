/* ========== 流程页 ========== */
.sc-page {
  min-height: 100vh;
  background: #fdf6e9;
  padding: 50rpx 40rpx 70rpx;
  box-sizing: border-box;
}

.sc-eyebrow {
  text-align: center;
  font-size: 20rpx;
  letter-spacing: 8rpx;
  color: #dba385;
  font-family: "Georgia", serif;
}

.sc-title {
  margin-top: 10rpx;
  text-align: center;
  font-size: 40rpx;
  letter-spacing: 12rpx;
  color: #e2402c;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
  font-weight: bold;
}

.sc-date {
  margin-top: 14rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 3rpx;
  color: #b08a6a;
}

.sc-card {
  margin-top: 34rpx;
  background: #fffdf8;
  border: 1rpx solid #f3e6d0;
  border-radius: 20rpx;
  padding: 36rpx 38rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 30rpx rgba(226, 64, 44, 0.06);
}

.sc-venue {
  text-align: center;
}

.sc-venue-name {
  font-size: 30rpx;
  color: #4a3a32;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.sc-venue-addr {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #a08b74;
}

/* ========== 时间线 ========== */
.timeline {
  width: 86%;
  margin: 0 auto;
}

.tl-item {
  display: flex;
  align-items: flex-start;
}

.tl-time {
  width: 130rpx;
  font-size: 30rpx;
  color: #e2402c;
  font-weight: bold;
  letter-spacing: 2rpx;
  line-height: 1;
  margin-top: 2rpx;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e2402c;
  flex-shrink: 0;
}

.tl-line {
  width: 2rpx;
  height: 52rpx;
  background: #f0cdb4;
  margin-left: 7rpx;
}

.tl-label {
  margin-left: 26rpx;
  font-size: 30rpx;
  color: #5a4638;
  letter-spacing: 3rpx;
  margin-top: -4rpx;
}

/* ========== 到场回执 ========== */
.rsvp-title {
  font-size: 32rpx;
  color: #e2402c;
  letter-spacing: 6rpx;
  font-weight: bold;
  text-align: center;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}

.rsvp-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a08b74;
  text-align: center;
}

.rsvp-opts {
  display: flex;
  margin-top: 26rpx;
}

.rsvp-opt {
  flex: 1;
  border: 2rpx solid #eec9b8;
  border-radius: 40rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #b08a6a;
  background: #fffdf8;
  text-align: center;
  box-sizing: border-box;
}

.rsvp-opt + .rsvp-opt {
  margin-left: 24rpx;
}

.opt-on {
  background: #e2402c;
  border-color: #e2402c;
  color: #fff8ef;
  font-weight: bold;
}

.opt-off-on {
  background: #a09484;
  border-color: #a09484;
  color: #fff8ef;
  font-weight: bold;
}

.rsvp-guests {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
  background: #faf3e6;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}

.rg-label {
  font-size: 26rpx;
  color: #8a6a55;
}

.rg-ctrl {
  display: flex;
  align-items: center;
}

.rg-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid #eec9b8;
  color: #e2402c;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fffdf8;
  box-sizing: border-box;
}

.rg-num {
  width: 90rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #e2402c;
}

.rsvp-name {
  margin-top: 24rpx;
  background: #faf3e6;
  border-radius: 16rpx;
  padding: 18rpx 26rpx;
  font-size: 26rpx;
  color: #5a4638;
}

.sc-btn {
  margin-top: 26rpx;
  width: 100%;
  font-size: 28rpx;
  border-radius: 44rpx;
  line-height: 2.6;
  background: linear-gradient(135deg, #ea5a42 0%, #e2402c 100%);
  color: #fff8ef;
  letter-spacing: 3rpx;
  box-shadow: 0 6rpx 20rpx rgba(226, 64, 44, 0.3);
}

.sc-btn::after {
  border: none;
}

.rsvp-stats {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #a08b74;
  text-align: center;
}

.rsvp-num {
  color: #e2402c;
  font-weight: bold;
  font-size: 26rpx;
}

.sc-foot {
  margin-top: 46rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  color: #8a5a4a;
  font-family: "Kaiti SC", "STKaiti", "KaiTi", serif;
}
