/* 页面容器 */
.page {
  min-height: 100vh;
  background: #f8f8f8;
}

/* ========== 头部 ========== */
.header {
  padding: 24rpx 32rpx;
  text-align: center;
  background: #ffffff;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

/* ========== 相册网格（4列） ========== */
.gallery {
  display: flex;
  flex-wrap: wrap;
  padding: 4rpx 0;
}

.gallery-item {
  width: 25%;
  height: 187rpx;
  padding: 2rpx;
  box-sizing: border-box;
  background: #e8e8e8;
}

.gallery-item-hover {
  opacity: 0.85;
}

.gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* ========== 加载占位 ========== */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #bbbbbb;
  letter-spacing: 2rpx;
}

/* ========== 底部信息 ========== */
.footer {
  text-align: center;
  padding: 48rpx 32rpx 64rpx;
  color: #bbbbbb;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
